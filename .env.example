# Skopiuj do .env.local (lokalnie) albo ustaw w Vercel → Settings → Environment Variables.

# Adres WordPressa z wtyczką peritus-core (bez ukośnika na końcu).
# Puste = oferty z data/properties.json (np. praca bez WP).
#   lokalnie (docker, wordpress/docker-compose.yml): http://localhost:8088
#   produkcja:                                         https://cms.peritus-nieruchomosci.pl
WORDPRESS_API_URL=

# Wspólny sekret webhooka WP → /api/revalidate (ten sam w wp-config.php jako PERITUS_REVALIDATE_SECRET).
# Wygeneruj np.: openssl rand -hex 32
#   lokalnie (docker): local-dev-secret
REVALIDATE_SECRET=
